{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "extractionState" : "manual",
      "shouldTranslate" : false,
      "localizations" : {}
    },
    "%@ Details" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 詳細資訊"
          }
        }
      }
    },
    "%@ Pull down to try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 下拉即可重試。"
          }
        }
      }
    },
    "%@ Tap the switch to try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 點開關重試。"
          }
        }
      }
    },
    "%@ connects over HTTPS. Choose an SSH host to check plan usage." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 用 HTTPS 連線。請改選 SSH 主機查詢方案用量。"
          }
        }
      }
    },
    "%@ didn’t start, so the host put %@ back." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 無法啟動，主機已換回 %2$@。"
          }
        }
      }
    },
    "%@ file %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@檔案 %2$@"
          }
        }
      }
    },
    "%@ finished" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 完成了"
          }
        }
      }
    },
    "%@ free, then %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免費 %1$@，之後 %2$@"
          }
        }
      }
    },
    "%@ is still working" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 仍在工作"
          }
        }
      }
    },
    "%@ keys aren’t supported. Use this device’s key, or an ed25519 or ECDSA key." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支援 %@ 金鑰。請改用這支裝置的金鑰，或 ed25519、ECDSA 金鑰。"
          }
        }
      }
    },
    "%@ needs you" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 需要你"
          }
        }
      }
    },
    "%@ per %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@／%2$@"
          }
        }
      }
    },
    "%@ renews automatically at %@ unless you cancel at least 24 hours before the end of the current period. Payment is charged to your Apple Account. Manage or cancel anytime in Settings › Apple Account › Subscriptions." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非在本期結束前至少 24 小時取消，%1$@ 會以 %2$@ 自動續訂。款項向你的 Apple 帳號收取。隨時可以在「設定」›「Apple 帳號」›「訂閱項目」管理或取消。"
          }
        }
      }
    },
    "%@ replied: %@" : {
      "extractionState" : "manual",
