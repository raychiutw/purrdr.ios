    "That chat’s record is no longer on the host, so it can’t be resumed. Pick another chat, or start a new one." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那段聊天的紀錄已不在主機上，無法續接。請選別的聊天，或開始新的聊天。"
          }
        }
      }
    },
    "That device can’t connect to this host until it’s paired again." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那支裝置要重新配對才能再連到這台主機。"
          }
        }
      }
    },
    "That device stops receiving notifications from all hosts. To get them again, turn notifications back on from that device." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
