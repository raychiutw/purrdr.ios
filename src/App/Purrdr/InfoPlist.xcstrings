{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "comment" : "相機權限說明：聊天拍照與掃描主機配對 QR code(#250)。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purrdr uses the camera to take photos for your chats and to scan the pairing QR code a host shows."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purrdr 會用相機拍照傳到聊天，以及掃描主機顯示的配對 QR code。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "相簿權限說明：「＋附加」面板顯示最近的照片(#352)。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purrdr shows your recent photos so you can attach them to a chat. Photos stay on your device until you send them."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purrdr 會顯示你最近的照片，讓你附加到聊天。照片在你送出前都留在這支裝置上。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Face ID 權限說明:App 鎖(#284)。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purrdr uses Face ID to unlock the app when App Lock is on."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟 App 鎖時，Purrdr 會用 Face ID 解鎖 app。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
