{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://purrdr.app/protocol/host-service.schema.json",
  "title": "Purrdr 主機服務協定",
  "description": "app 與主機服務之間的 JSON 訊息(ADR-0010):WSS 上的訊息，以及連線配對與撤銷的 HTTPS 請求本文。這份檔案是唯一定義:Rust 與 Swift 型別都由它產生(host-service/codegen)。解碼端一律忽略未知欄位。WSS 與 POST /v1/revoke 都以 Authorization: Bearer <裝置權杖> 認證。",
  "x-protocol-version": 1,
  "$defs": {
    "ClientMessage": {
      "description": "app 送給主機服務的訊息，以 type 區分。標 x-write 的是寫入類操作，唯讀裝置送出時被拒絕(read_only_device)。",
      "oneOf": [
        { "$ref": "#/$defs/Hello" },
        { "$ref": "#/$defs/AgentsList" },
        { "$ref": "#/$defs/PaneSendKeys" },
        { "$ref": "#/$defs/EventsSubscribe" },
        { "$ref": "#/$defs/EventsUnsubscribe" }
      ]
    },
    "ServerMessage": {
      "description": "主機服務送給 app 的訊息，以 type 區分。",
      "oneOf": [
        { "$ref": "#/$defs/Welcome" },
        { "$ref": "#/$defs/AgentsListResult" },
        { "$ref": "#/$defs/PaneSendKeysResult" },
        { "$ref": "#/$defs/EventsSubscribeResult" },
        { "$ref": "#/$defs/SubscribedEvent" },
        { "$ref": "#/$defs/EventsEnded" },
        { "$ref": "#/$defs/EventsUnsubscribeResult" },
        { "$ref": "#/$defs/ErrorMessage" }
      ]
    },
    "Hello": {
      "description": "握手：連線後第一個請求，帶 app 使用的協定版本。",
      "type": "object",
      "properties": {
        "type": { "const": "hello" },
        "request_id": { "type": "string", "description": "請求識別碼，回應帶回同一個值。" },
        "protocol_version": { "type": "integer", "minimum": 1 },
        "app_version": { "type": "string", "description": "app 版本，只用於診斷。" }
      },
      "required": ["type", "request_id", "protocol_version"]
    },
    "Welcome": {
      "description": "握手成功：主機服務的協定版本、版本，以及 herdr 伺服器 ping 回報的版本與能力。",
      "type": "object",
      "properties": {
        "type": { "const": "welcome" },
        "request_id": { "type": "string" },
        "protocol_version": { "type": "integer", "minimum": 1 },
        "host_service_version": { "type": "string" },
        "herdr": { "$ref": "#/$defs/HerdrServer" }
      },
      "required": ["type", "request_id", "protocol_version", "host_service_version", "herdr"]
    },
    "HerdrServer": {
      "description": "herdr 伺服器(不是 CLI)的版本與能力。",
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "protocol": { "type": "integer", "minimum": 0 },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "ping 的 capabilities 裡值為 true 的名稱。"
        }
      },
      "required": ["version", "protocol", "capabilities"]
    },
    "AgentsList": {
      "description": "取得 Agent 列表(herdr session.snapshot)。",
      "type": "object",
      "properties": {
        "type": { "const": "agents.list" },
        "request_id": { "type": "string" }
      },
      "required": ["type", "request_id"]
    },
    "AgentsListResult": {
      "description": "Agent 列表與它們所在的 workspace。",
      "type": "object",
      "properties": {
        "type": { "const": "agents.list.result" },
        "request_id": { "type": "string" },
        "workspaces": { "type": "array", "items": { "$ref": "#/$defs/Workspace" } },
        "agents": { "type": "array", "items": { "$ref": "#/$defs/Agent" } }
      },
      "required": ["type", "request_id", "workspaces", "agents"]
    },
    "Workspace": {
      "type": "object",
      "properties": {
        "workspace_id": { "type": "string" },
        "label": { "type": "string" }
      },
      "required": ["workspace_id", "label"]
    },
    "Agent": {
      "description": "herdr 在某個 Pane 偵測到的 Agent。",
      "type": "object",
      "properties": {
        "pane_id": { "type": "string" },
        "workspace_id": { "type": "string" },
        "tab_id": { "type": "string" },
        "agent": { "type": "string", "description": "herdr 的 agent 名稱，例如 claude、codex。" },
        "status": { "$ref": "#/$defs/AgentStatus" },
        "title": { "type": "string", "description": "去掉狀態符號的終端機標題。" },
        "cwd": { "type": "string" },
        "session": { "$ref": "#/$defs/AgentSession" }
      },
      "required": ["pane_id", "workspace_id", "tab_id", "status"]
    },
    "AgentStatus": {
      "description": "herdr 回報的 Agent 狀態。",
      "type": "string",
      "enum": ["idle", "working", "blocked", "done", "unknown"]
    },
    "AgentSession": {
      "description": "herdr 的 agent_session:定位對話紀錄用。",
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "agent": { "type": "string" },
        "kind": { "type": "string" },
        "value": { "type": "string" }
      },
      "required": ["source", "agent", "kind", "value"]
    },
    "PaneSendKeys": {
      "description": "對 Pane 送出按鍵(herdr pane.send_keys)。",
      "type": "object",
      "x-write": true,
      "properties": {
        "type": { "const": "pane.send_keys" },
        "request_id": { "type": "string" },
        "pane_id": { "type": "string" },
        "keys": { "type": "array", "items": { "type": "string" }, "description": "herdr 鍵名，例如 enter、esc、ctrl+c。" }
      },
      "required": ["type", "request_id", "pane_id", "keys"]
    },
    "PaneSendKeysResult": {
      "description": "按鍵已送到 Pane。",
      "type": "object",
      "properties": {
        "type": { "const": "pane.send_keys.result" },
        "request_id": { "type": "string" }
      },
      "required": ["type", "request_id"]
    },
    "EventsSubscribe": {
      "description": "開一條 Agent 事件串流(herdr events.subscribe)。herdr 接受後回 events.subscribe.result,之後以 events.event 推送，直到 events.ended 或 events.unsubscribe。事件只是「該重讀了」的訊號，對帳用 agents.list。",
      "type": "object",
      "properties": {
        "type": { "const": "events.subscribe" },
        "request_id": { "type": "string" },
        "stream_id": { "type": "string", "description": "串流識別碼(app 自訂，同一條連線內不可重複);這條串流的訊息都帶它。" },
        "subscriptions": { "type": "array", "items": { "$ref": "#/$defs/EventSubscription" } }
      },
      "required": ["type", "request_id", "stream_id", "subscriptions"]
    },
    "EventSubscription": {
      "description": "一筆 herdr 事件訂閱。herdr 不認得的事件或不存在的 Pane 會讓整個訂閱被拒(herdr_error)。",
      "type": "object",
      "properties": {
        "event": { "type": "string", "description": "herdr 的訂閱型別，例如 pane.agent_status_changed、workspace.created。" },
        "pane_id": { "type": "string", "description": "pane.agent_status_changed 必填;其他型別不帶。" }
      },
      "required": ["event"]
    },
    "EventsSubscribeResult": {
      "description": "herdr 接受了訂閱。此後的變化才會推送;之前的要靠 agents.list 對帳。",
      "type": "object",
      "properties": {
        "type": { "const": "events.subscribe.result" },
        "request_id": { "type": "string" },
        "stream_id": { "type": "string" }
      },
      "required": ["type", "request_id", "stream_id"]
    },
    "SubscribedEvent": {
      "description": "herdr 推送的一個事件(沒有 request_id)。",
      "type": "object",
      "properties": {
        "type": { "const": "events.event" },
        "stream_id": { "type": "string" },
        "event": { "type": "string", "description": "herdr 事件的 wire 名稱，例如 pane_agent_status_changed。" },
        "pane_id": { "type": "string", "description": "事件指名 Pane 時才有。" }
      },
      "required": ["type", "stream_id", "event"]
    },
    "EventsEnded": {
      "description": "事件串流在主機端結束(沒有 request_id)。有 code 表示失敗;herdr 的 events_lost 是 code herdr_error 加 herdr_code events_lost,app 重新訂閱並對帳。",
      "type": "object",
      "properties": {
        "type": { "const": "events.ended" },
        "stream_id": { "type": "string" },
        "code": { "$ref": "#/$defs/ErrorCode" },
        "message": { "type": "string", "description": "給開發者看的說明。" },
        "herdr_code": { "type": "string", "description": "code 是 herdr_error 時，herdr 原本的錯誤碼。" }
      },
      "required": ["type", "stream_id"]
    },
    "EventsUnsubscribe": {
      "description": "關閉一條事件串流，主機服務關掉對應的 herdr 訂閱。不認得的串流識別碼也回成功。",
      "type": "object",
      "properties": {
        "type": { "const": "events.unsubscribe" },
        "request_id": { "type": "string" },
        "stream_id": { "type": "string" }
      },
      "required": ["type", "request_id", "stream_id"]
    },
    "EventsUnsubscribeResult": {
      "description": "事件串流已關閉，之後不再有這條串流的訊息。",
      "type": "object",
      "properties": {
        "type": { "const": "events.unsubscribe.result" },
        "request_id": { "type": "string" }
      },
      "required": ["type", "request_id"]
    },
    "PairRequest": {
      "description": "POST /v1/pair 的本文：以配對碼換裝置權杖。QR code 的內容是 purrdr://pair?address=<HTTPS 位址>&code=<配對碼>。",
      "type": "object",
      "properties": {
        "pairing_code": { "type": "string", "description": "大小寫與連字號不拘，例如 K7QM-2XPA。" },
        "device_name": { "type": "string", "description": "顯示在主機裝置列表的名稱。" }
      },
      "required": ["pairing_code", "device_name"]
    },
    "PairResponse": {
      "description": "配對成功。device_token 只在這裡出現一次，主機只存雜湊。",
      "type": "object",
      "properties": {
        "device_id": { "type": "string" },
        "device_token": { "type": "string" },
        "read_only": { "type": "boolean", "description": "唯讀裝置的寫入類操作會被拒絕(read_only_device)。" }
      },
      "required": ["device_id", "device_token", "read_only"]
    },
    "ErrorMessage": {
      "description": "請求失敗(WSS 訊息，也是配對與撤銷 HTTPS 請求失敗時的本文)。訊息本身無法解析時沒有 request_id。",
      "type": "object",
      "properties": {
        "type": { "const": "error" },
        "request_id": { "type": "string" },
        "code": { "$ref": "#/$defs/ErrorCode" },
        "message": { "type": "string", "description": "給開發者看的說明，不顯示給使用者。" },
        "herdr_code": { "type": "string", "description": "code 是 herdr_error 時，herdr 原本的錯誤碼。" },
        "supported_protocol_versions": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "code 是 protocol_version_unsupported 時，主機服務支援的協定版本。"
        }
      },
      "required": ["type", "code", "message"]
    },
    "ErrorCode": {
      "description": "錯誤種類。WSS 收到 device_token_invalid／device_token_revoked 後，主機服務以 close code 4401 關閉連線;HTTPS 請求回 401。",
      "type": "string",
      "enum": [
        "invalid_message",
        "handshake_required",
        "protocol_version_unsupported",
        "herdr_unavailable",
        "herdr_capability_missing",
        "herdr_error",
        "device_token_invalid",
        "device_token_revoked",
        "read_only_device",
        "pairing_code_invalid",
        "pairing_code_expired",
        "internal_error"
      ]
    }
  }
}
