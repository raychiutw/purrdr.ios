{
  "description": "主機取檔的存取規則(raychiutw/purrdr.ios#227)。app(HostFileAccessPolicy)、主機服務(host_files.rs)、SSH 的 POSIX 取檔腳本與 Windows PowerShell 取檔腳本跑同一組案例。",
  "environment": {
    "posix": {
      "home": "/home/demo",
      "transcript": "/home/demo/.claude/projects/-home-demo-ledger/s1.jsonl"
    },
    "windows": {
      "home": "C:\\Users\\Demo",
      "transcript": "C:\\Users\\Demo\\.claude\\projects\\C--Users-Demo-ledger\\s1.jsonl"
    }
  },
  "accessDescription": "accessCases:path 是請求的路徑,workingDirectory 是 herdr 回報的 Agent 工作目錄,mentioned 表示路徑出現在對話紀錄中 Agent 自己寫出的地方。expected 只看路徑判斷(不碰檔案系統)。root 是 app 送給 SSH 取檔腳本的工作目錄(null 是 `-`,只因提到而放行),腳本收到後自己再判斷一次。only 列出適用的實作(app、host-service、posix、powershell),沒有就是全部。",
  "accessCases": [
    {
      "name": "工作目錄之下",
      "platform": "posix",
      "path": "/home/demo/ledger/docs/a.png",
      "workingDirectory": "/home/demo/ledger",
      "mentioned": false,
      "expected": "allowed",
      "root": "/home/demo/ledger"
    },
    {
      "name": "名稱開頭相同的兄弟資料夾不算在工作目錄之下",
